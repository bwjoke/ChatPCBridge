<Window x:Class="ChatPCBridge.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ChatPCBridge" Width="1040" Height="730" MinWidth="900" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="#F5F7F9" FontFamily="Microsoft YaHei UI" FontSize="14"
 AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="ChatPCBridge" FontSize="28" FontWeight="SemiBold" Foreground="#142B30"/>
    <TextBlock Text="把微信聊天记录带到 ChatGPT" Margin="0,7,0,0" Foreground="#52656D" FontSize="16"/>
   </StackPanel>
   <Button Content="导入 ZIP / TXT" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ImportClick"/>
  </Grid>
  <Border Grid.Row="1" Background="#E4F4EF" CornerRadius="10" Padding="18,14" Margin="0,22,0,20">
   <StackPanel><TextBlock Text="微信多选 → 合并转发 → 转发到其他应用 → ChatPCBridge" Foreground="#125A48" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="也可以把已有 ZIP 拖到这个窗口。原始文件会完整保留在本机。" Margin="0,6,0,0" Foreground="#3D6C61"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="14">
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="接收记录" FontWeight="SemiBold" Foreground="#53646B" Margin="0,0,0,12"/>
     <ListBox x:Name="HistoryList" SelectionChanged="HistoryChanged" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,9"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="#657780" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock x:Name="DetailTitle" Text="准备好接收聊天记录" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailMeta" Text="首次转发后，文件会显示在这里。" Foreground="#657780" Margin="0,9,0,15" TextWrapping="Wrap"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBox x:Name="DetailText" Text="选择左侧的接收记录，可复制 ZIP、查看原件，或使用提取的聊天 TXT。" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#41525B" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" Padding="0"/></ScrollViewer>
     <WrapPanel Grid.Row="2" Margin="0,20,0,0">
      <Button x:Name="SendButton" Content="复制 ZIP 并打开 ChatGPT" Background="#087C65" Foreground="White" Click="SendClick" IsEnabled="False"/>
      <Button x:Name="FolderButton" Content="打开文件夹" Click="FolderClick" IsEnabled="False"/>
      <Button x:Name="TextButton" Content="复制聊天 TXT" Click="TextClick" IsEnabled="False"/>
      <Button Content="复制分析提示词" Click="PromptClick"/>
     </WrapPanel>
     <TextBlock Grid.Row="3" Text="在 ChatGPT 输入框按 Ctrl+V，或从文件夹拖入文件。若 ZIP 不被接受，可改用聊天 TXT；上传成功以 ChatGPT 的附件显示为准。" Foreground="#73818A" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,19,0,0">
   <DockPanel><CheckBox x:Name="AutoOpenCheck" Content="收到微信分享后，自动复制文件并打开 ChatGPT" VerticalAlignment="Center" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
    <ComboBox x:Name="TargetCombo" Width="165" HorizontalAlignment="Right" SelectionChanged="SettingsChanged"><ComboBoxItem Content="当前新版 ChatGPT" Tag="current"/><ComboBoxItem Content="ChatGPT Classic" Tag="classic"/><ComboBoxItem Content="ChatGPT 网页版" Tag="web"/></ComboBox>
   </DockPanel>
   <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,14,0,0"/>
   <TextBlock x:Name="StatusText" Text="等待从微信分享，或导入已有文件。" Foreground="#52656D" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</Window>
